{
  "name": "trace-enterprise-api",
  "version": "3.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node scripts/start-api.mjs",
    "start:prod": "node scripts/start-api.mjs",
    "worker": "node scripts/start-worker.mjs",
    "worker:dev": "tsx watch src/worker.ts",
    "migrate": "prisma migrate dev && npm run db:seed",
    "db:push": "prisma db push && npm run db:seed",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:types": "tsc -p tsconfig.json --noEmit",
    "doctor": "node scripts/runtime-check.mjs",
    "deploy:prod": "npm ci --omit=dev && npm run doctor",
    "postinstall": "prisma generate",
    "build:secure": "node scripts/secure-build.mjs",
    "build:secure:strict": "REQUIRE_OBFUSCATOR=true node scripts/secure-build.mjs",
    "start:secure": "SECURE_MANIFEST_REQUIRED=true node scripts/start-secure-api.mjs",
    "db:migrate:safe": "node scripts/migrate-safe.mjs",
    "db:migrate:deploy": "node scripts/migrate-safe.mjs",
    "db:repair:product-trace-migration": "node scripts/repair-product-trace-box-link-migration.mjs",
    "db:repair:public-query-schema": "node scripts/repair-public-query-schema.mjs",
    "db:repair:shipment-origin": "node scripts/repair-shipment-sender-location.mjs",
    "db:repair:box-shipments-columns": "node scripts/repair-box-shipment-columns.mjs",
    "db:seed": "node scripts/run-seed.mjs",
    "db:clear": "node scripts/db-clear.mjs",
    "admin:check": "node scripts/check-admin.mjs",
    "admin:reset-password": "node scripts/reset-admin-password.mjs",
    "security:generate-code-keys": "node scripts/generate-anti-fake-keys.mjs",
    "db:migrate:anti-fake-code-vault": "node scripts/migrate-anti-fake-code-vault.mjs",
    "db:repair:anti-fake-code-schema": "node scripts/repair-anti-fake-code-schema.mjs",
    "test": "tsx --test test/*.test.ts",
    "test:targeted": "tsx --test test/anti-channeling-automation.test.ts",
    "test:ai-toggle": "tsx scripts/check-ai-feature-toggle.mjs"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^9.1.3",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.11",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.11",
    "@nestjs/swagger": "^11.0.6",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.4.1",
    "archiver": "^8.0.0",
    "argon2": "^0.41.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.41.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express": "^5.2.1",
    "fastify": "^5.2.1",
    "ioredis": "^5.5.0",
    "nanoid": "^5.0.9",
    "nestjs-pino": "^4.3.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.4.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.5",
    "@types/qrcode": "^1.5.5",
    "bytenode": "^1.5.7",
    "javascript-obfuscator": "^4.1.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20 <25",
    "npm": ">=10"
  }
}
